# FastAPI Chat Backend - Environment Variables
# Copy this file to `.env` and fill in the appropriate values.

# REQUIRED: Your OpenAI API key
OPENAI_API_KEY=sk-REPLACE_ME

# OPTIONAL: Override base URL for OpenAI-compatible endpoints (e.g., Azure/OpenAI proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# OPTIONAL: Default model if not specified in request
MODEL_FALLBACK=gpt-4o-mini

# OPTIONAL: Site URL (used for redirects or external linking if needed)
SITE_URL=http://localhost:3000
